# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
VITE_RESEND_API_KEY="re_xxxxxxxx"
VITE_ADMIN_NOTIFICATION_EMAIL="admin@example.com"
VITE_RESEND_SENDER_EMAIL="send@irisjev.in"
VITE_SITE_URL="https://swarnawoodencrafts.com"

# ==============================================================================
# NETLIFY SERVER-SIDE ENVIRONMENT VARIABLES (Must be set in Netlify Site Settings)
# NEVER prefix these with VITE_ to keep secrets out of client browser bundles.
# ==============================================================================
META_WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_cloud_api_access_token_here"
META_WHATSAPP_PHONE_NUMBER_ID="1442648035597125"
META_WHATSAPP_API_VERSION="v21.0"
N8N_WEBHOOK_URL="https://suganadmin.app.n8n.cloud/webhook/your-webhook-id"
N8N_WEBHOOK_SECRET="optional_n8n_secret_key"